{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open.cait518.cc/schemas/owned-feed-receipt-v1.json",
  "title": "Generation-bound publisher ACK, not subscriber delivery or indexing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "attempt_id", "intent_id", "protocol", "endpoint", "topic", "request", "response", "outcome", "accepted_ack", "subscriber_delivery_verified", "indexing_verified"],
  "properties": {
    "schema": {"const": "lumi.owned-feed-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "intent_id": {"$ref": "#/$defs/sha256"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "protocol": {"enum": ["websub", "rsscloud"]},
    "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
    "topic": {"type": "string", "format": "uri", "pattern": "^https://"},
    "outcome": {"enum": ["accepted_ack", "retryable_error", "rejected", "body_mismatch", "indeterminate"]},
    "accepted_ack": {"type": "boolean"},
    "subscriber_delivery_verified": {"const": false},
    "indexing_verified": {"const": false},
    "fixture": {"const": true},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "feed_generation_sha256", "inventory_sha256", "source_sha", "engine_source_sha", "deployment_sha256", "feed_sha256", "method", "content_type", "topics", "request_body", "request_sha256", "started_at"],
      "properties": {
        "generation_id": {"$ref": "#/$defs/sha256"},
        "feed_generation_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "engine_source_sha": {"$ref": "#/$defs/sha40"},
        "deployment_sha256": {"$ref": "#/$defs/sha256"},
        "feed_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"const": "POST"},
        "content_type": {"const": "application/x-www-form-urlencoded; charset=utf-8"},
        "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "request_body": {"type": "string"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"$ref": "#/$defs/instant"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_status", "ack_body", "ack_body_sha256", "observed_at", "endpoint", "final_url", "topics", "request_sha256", "retry_after_seconds", "transport_error"],
      "properties": {
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "ack_body": {"type": "string", "maxLength": 65536},
        "ack_body_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {"$ref": "#/$defs/instant"},
        "endpoint": {"type": ["string", "null"]},
        "final_url": {"type": ["string", "null"]},
        "topics": {"type": ["array", "null"], "items": {"type": "string"}},
        "request_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "retry_after_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 300},
        "transport_error": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"accepted_ack": {"const": true}}},
      "then": {"properties": {"outcome": {"const": "accepted_ack"}, "response": {"properties": {"http_status": {"enum": [200, 202, 204]}, "transport_error": {"type": "null"}}}}},
      "else": {"properties": {"outcome": {"not": {"const": "accepted_ack"}}}}
    },
    {
      "if": {"properties": {"protocol": {"const": "rsscloud"}, "accepted_ack": {"const": true}}},
      "then": {"properties": {"response": {"properties": {"http_status": {"const": 200}}}}}
    },
    {
      "if": {"properties": {"protocol": {"const": "websub"}, "accepted_ack": {"const": true}, "response": {"properties": {"http_status": {"const": 204}}}}},
      "then": {"properties": {"response": {"properties": {"ack_body": {"const": ""}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "instant": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
