        "dcmiType:Text"
      ],
      "dcterms:title": {
        "@value": "Bopomofo: A 37-Symbol Reference",
        "@language": "en"
      },
      "dcterms:alternative": {
        "@value": "注音符號：37 符號完整參考手冊",
        "@language": "zh-Hant"
      },
      "dcterms:creator": {
        "@id": "https://open.cait518.cc/ios-app-guide/#organization"
      },
      "dcterms:publisher": {
        "@id": "https://open.cait518.cc/ios-app-guide/#organization"
      },
      "dcterms:subject": [
        {
          "@value": "Bopomofo (Zhuyin)",
          "@language": "en"
        },
        {
          "@value": "Mandarin phonetic symbols",
          "@language": "en"
        },
        {
          "@value": "Traditional Chinese literacy support",
          "@language": "en"
        }
      ],
      "dcterms:description": [
        {
          "@value": "A free, text-first EPUB 3.3 reference for all 37 Bopomofo symbols, with Pinyin, broad IPA, examples and open OPDS catalogs. It is a text-only supporting document for beginner reference and guided instruction.",
          "@language": "en"
        },
        {
          "@value": "Text-only symbol reference; no audio, pronunciation scoring, diagnostic assessment, school-readiness judgement, formal standards alignment or complete Chinese course.",
          "@language": "en"
        },
        {
          "@value": "No fixed age range. Beginner learners of any age can use the reference; children should use it with a caregiver or educator.",
          "@language": "en"
        }
      ],
