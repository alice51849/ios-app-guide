    "encoding": "utf-8",
    "header": true,
    "headerRowCount": 1,
    "delimiter": ",",
    "quoteChar": "\"",
    "doubleQuote": true,
    "lineTerminators": [
      "\n"
    ],
    "skipBlankRows": false,
    "skipColumns": 0,
