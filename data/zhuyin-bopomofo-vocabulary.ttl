@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix zhuyin: <https://open.cait518.cc/ios-app-guide/data/zhuyin-bopomofo-vocabulary.html#> .

zhuyin:scheme
    a skos:ConceptScheme, schema:DefinedTermSet ;
    skos:prefLabel "Bopomofo (Zhuyin) 37-Symbol Vocabulary"@en, "注音符號 37 符號詞彙"@zh-Hant ;
    dcterms:title "Bopomofo (Zhuyin) 37-Symbol Vocabulary"@en, "注音符號 37 符號詞彙"@zh-Hant ;
    dcterms:description "A bilingual SKOS concept scheme for all 37 Bopomofo symbols, including Pinyin, broad IPA, Unicode notation and example words."@en, "完整涵蓋 37 個注音符號的雙語 SKOS concept scheme，包含漢語拼音、寬式 IPA、Unicode notation 與例字。"@zh-Hant ;
    dcterms:creator <https://open.cait518.cc/ios-app-guide/#organization> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://open.cait518.cc/ios-app-guide/data/zhuyin-bopomofo.json>, <https://language.moe.gov.tw/001/Upload/files/site_content/M0001/juyin/index.html>, <https://www.unicode.org/charts/PDF/U3100.pdf> ;
    dcterms:conformsTo <https://www.w3.org/TR/skos-reference/> ;
    dcterms:created "2026-07-11"^^xsd:date ;
    dcterms:modified "2026-09-04"^^xsd:date ;
    schema:numberOfItems "37"^^xsd:integer ;
    skos:hasTopConcept zhuyin:initials, zhuyin:medials, zhuyin:finals .

<https://open.cait518.cc/ios-app-guide/#organization>
    a schema:Organization ;
    schema:name "Lumi Apps - iOS App Guide" .

zhuyin:pinyin
    a rdf:Property ;
    rdfs:label "Hanyu Pinyin"@en, "漢語拼音"@zh-Hant ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

zhuyin:ipa
    a rdf:Property ;
    rdfs:label "broad IPA"@en, "寬式 IPA"@zh-Hant ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

zhuyin:exampleCharacter
    a rdf:Property ;
    rdfs:label "example character"@en, "例字"@zh-Hant ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

zhuyin:examplePinyin
    a rdf:Property ;
    rdfs:label "example Pinyin"@en, "例字拼音"@zh-Hant ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

zhuyin:exampleMeaning
    a rdf:Property ;
    rdfs:label "example meaning"@en, "例字英文意思"@zh-Hant ;
    rdfs:domain skos:Concept ;
    rdfs:range rdfs:Literal .

zhuyin:initials
    a skos:Concept ;
    skos:prefLabel "Zhuyin initials"@en, "注音聲母"@zh-Hant ;
    skos:definition "The 21 consonant initials in the Zhuyin system."@en, "注音符號系統中的 21 個聲母。"@zh-Hant ;
    skos:notation "initial"^^xsd:string ;
    skos:inScheme zhuyin:scheme ;
    skos:topConceptOf zhuyin:scheme ;
    skos:narrower zhuyin:u3105, zhuyin:u3106, zhuyin:u3107, zhuyin:u3108, zhuyin:u3109, zhuyin:u310A, zhuyin:u310B, zhuyin:u310C, zhuyin:u310D, zhuyin:u310E, zhuyin:u310F, zhuyin:u3110, zhuyin:u3111, zhuyin:u3112, zhuyin:u3113, zhuyin:u3114, zhuyin:u3115, zhuyin:u3116, zhuyin:u3117, zhuyin:u3118, zhuyin:u3119 .

zhuyin:medials
    a skos:Concept ;
    skos:prefLabel "Zhuyin medials"@en, "注音介音"@zh-Hant ;
    skos:definition "The three glide medials in the Zhuyin system."@en, "注音符號系統中的 3 個介音。"@zh-Hant ;
    skos:notation "medial"^^xsd:string ;
    skos:inScheme zhuyin:scheme ;
    skos:topConceptOf zhuyin:scheme ;
    skos:narrower zhuyin:u3127, zhuyin:u3128, zhuyin:u3129 .

zhuyin:finals
    a skos:Concept ;
    skos:prefLabel "Zhuyin finals"@en, "注音韻母"@zh-Hant ;
    skos:definition "The 13 vowel finals in the Zhuyin system."@en, "注音符號系統中的 13 個韻母。"@zh-Hant ;
    skos:notation "final"^^xsd:string ;
    skos:inScheme zhuyin:scheme ;
    skos:topConceptOf zhuyin:scheme ;
    skos:narrower zhuyin:u311A, zhuyin:u311B, zhuyin:u311C, zhuyin:u311D, zhuyin:u311E, zhuyin:u311F, zhuyin:u3120, zhuyin:u3121, zhuyin:u3122, zhuyin:u3123, zhuyin:u3124, zhuyin:u3125, zhuyin:u3126 .

zhuyin:u3105
    a skos:Concept, schema:DefinedTerm ;
    skos:prefLabel "Bopomofo symbol ㄅ"@en, "ㄅ"@zh-Hant ;
    skos:altLabel "b"@zh-Latn-pinyin ;
    skos:definition "The Zhuyin initial ㄅ, corresponding to Hanyu Pinyin b and broad IPA [p]. Example: 爸 (bà), father."@en, "注音聲母 ㄅ，對應漢語拼音 b 與寬式 IPA [p]；例字：爸（bà）。"@zh-Hant ;
    skos:notation "U+3105"^^xsd:string ;
    skos:inScheme zhuyin:scheme ;
    skos:broader zhuyin:initials ;
    dcterms:identifier "U+3105" ;
    schema:termCode "U+3105" ;
    zhuyin:pinyin "b"@zh-Latn-pinyin ;
    zhuyin:ipa "p" ;
    zhuyin:exampleCharacter "爸"@zh-Hant ;
    zhuyin:examplePinyin "bà"@zh-Latn-pinyin ;
    zhuyin:exampleMeaning "father"@en .

